rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated (Admin)
    function isAdmin() {
      return request.auth != null;
    }
    
    // Contact requests (inquiries): Public can create, Admin can do everything
    match /inquiries/{document=**} {
      allow create: if true 
                    && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'message', 'type', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.type == 'contact';
      allow read, update, delete: if isAdmin();
    }
    
    // Projects and Gallery: Public can read, Admin can do everything
    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery_images/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews: Public can read, Admin can do everything
    match /reviews/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Default fallback - closed by default
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
